
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Drive</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body class="bg-gray-50 text-gray-800">

    <div class="min-h-screen flex">

        
        <aside class="w-64 bg-white border-r border-gray-200 p-5 hidden md:flex flex-col">

            <h1 class="text-2xl font-bold text-blue-600 mb-10">
                <i class="ri-drive-line"></i> My Drive
            </h1>

            <nav class="space-y-3">
                <a href="/home" class="flex items-center gap-3 bg-blue-50 text-blue-600 p-3 rounded-lg font-semibold">
                    <i class="ri-home-4-line text-xl"></i>
                    Home
                </a>

                <a href="/my-files" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100">
                    <i class="ri-folder-line text-xl"></i>
                    My Files
                </a>
            </nav>

            <div class="mt-auto">
                <a href="/user/logout" class="flex items-center gap-3 p-3 rounded-lg text-red-500 hover:bg-red-50">
                    <i class="ri-logout-box-line text-xl"></i>
                    Logout
                </a>
            </div>

        </aside>


       
        <main class="flex-1 p-5 md:p-8">

           
            <header class="flex flex-wrap items-center justify-between gap-4 mb-8">

                <div>
                    <h2 class="text-2xl font-bold">Dashboard</h2>
                    <p class="text-gray-500 text-sm mt-1">
                        Welcome, <%= user.name %>!
                    </p>
                </div>

                <button
                    onclick="showPopup()"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-lg font-semibold">
                    <i class="ri-upload-2-line"></i>
                    Upload File
                </button>

            </header>


           
            <div class="mb-8">
                <div class="relative max-w-xl">
                    <i class="ri-search-line absolute left-4 top-3.5 text-gray-400"></i>
                    <input
                        type="text"
                        id="searchInput"
                        placeholder="Search your files..."
                        class="w-full pl-11 pr-4 py-3 border border-gray-200 rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>


           
            <section class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">

                <div class="bg-white p-6 rounded-xl border border-gray-200">
                    <div class="flex items-center justify-between">
                        <p class="text-gray-500">Total Files</p>
                        <i class="ri-folder-line text-2xl text-blue-500"></i>
                    </div>

                    <h3 class="text-3xl font-bold mt-3">
                        <%= files.length %>
                    </h3>
                </div>

                <div class="bg-white p-6 rounded-xl border border-gray-200">
                    <div class="flex items-center justify-between">
                        <p class="text-gray-500">Account</p>
                        <i class="ri-user-line text-2xl text-green-500"></i>
                    </div>

                    <h3 class="text-lg font-semibold mt-3">
                        <%= user.email %>
                    </h3>
                </div>

            </section>


            
            <section class="bg-white border border-gray-200 rounded-xl p-6">

                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-xl font-bold">My Files</h3>
                        <p class="text-gray-500 text-sm mt-1">
                            Your uploaded files
                        </p>
                    </div>

                    <a href="/my-files" class="text-blue-600 font-semibold text-sm">
                        View All
                    </a>
                </div>


                <% if (files.length === 0) { %>

                    <div class="text-center py-12">
                        <i class="ri-folder-upload-line text-5xl text-gray-300"></i>
                        <h3 class="text-lg font-semibold mt-3">No files yet</h3>
                        <p class="text-gray-500 text-sm mt-1">
                            Upload your first file to get started.
                        </p>
                    </div>

                <% } else { %>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="border-b text-gray-500 text-sm">
                                    <th class="py-3">File Name</th>
                                    <th class="py-3">Uploaded On</th>
                                    <th class="py-3">Actions</th>
                                </tr>
                            </thead>

                            <tbody id="fileList">

                                <% files.forEach(file => { %>

                                    <tr class="border-b file-row">

                                       
                                        <td class="py-4 font-medium min-w-40">
                                            <i class="ri-file-line text-blue-500 mr-2"></i>
                                            <span class="file-name"><%= file.filename %></span>
                                        </td>

                                        
                                        <td class="py-4 text-sm text-gray-500 whitespace-nowrap">
                                            <%= new Date(file.createdAt).toLocaleDateString() %>
                                        </td>

                                        
                                        <td class="py-4">
                                            <div class="flex items-center gap-3">

                                                
                                                <a
                                                    href="<%= file.fileUrl %>"
                                                    target="_blank"
                                                    class="text-blue-600 hover:underline">
                                                    <i class="ri-eye-line"></i> View
                                                </a>

                                               
                                                <button
                                                    type="button"
                                                    onclick="renameFile('<%= file._id %>', '<%= file.filename.replace(/\\/g, '\\\\').replace(/'/g, "\\'") %>')"
                                                    class="text-green-600 hover:underline">
                                                    <i class="ri-edit-line"></i> Rename
                                                </button>

                                                
                                                <form
                                                    action="/delete-file/<%= file._id %>"
                                                    method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this file?')">

                                                    <button
                                                        type="submit"
                                                        class="text-red-500 hover:underline">
                                                        <i class="ri-delete-bin-line"></i> Delete
                                                    </button>

                                                </form>

                                            </div>
                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>
                        </table>
                    </div>

                <% } %>

            </section>

        </main>

    </div>


   
    <div id="uploadPopup" class="hidden fixed inset-0 bg-black/50 items-center justify-center z-50 p-4">

        <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">

            <div class="flex justify-between items-center mb-5">
                <h2 class="text-xl font-bold">Upload File</h2>

                <button onclick="hidePopup()" class="text-gray-500 text-2xl">
                    <i class="ri-close-line"></i>
                </button>
            </div>

            <form action="/upload-file" method="POST" enctype="multipart/form-data">

                <label for="file" class="flex flex-col items-center justify-center h-48 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50">

                    <i class="ri-upload-cloud-2-line text-4xl text-blue-500 mb-3"></i>

                    <p class="text-sm text-gray-600">
                        Click to select a file
                    </p>

                    <input type="file" id="file" name="file" class="hidden" required>

                </label>

                <p id="selectedFile" class="text-sm text-gray-500 mt-3"></p>

                <button type="submit" class="w-full mt-5 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold">
                    Upload File
                </button>

            </form>

        </div>

    </div>


    <script>

        
        function showPopup() {
            const popup = document.getElementById('uploadPopup');
            popup.classList.remove('hidden');
            popup.classList.add('flex');
        }

        function hidePopup() {
            const popup = document.getElementById('uploadPopup');
            popup.classList.add('hidden');
            popup.classList.remove('flex');
        }

        
        document.getElementById('file').addEventListener('change', function() {
            document.getElementById('selectedFile').textContent =
                this.files.length ? this.files[0].name : '';
        });

      
        document.getElementById('searchInput').addEventListener('input', function() {
            const searchValue = this.value.toLowerCase();

            document.querySelectorAll('.file-row').forEach(row => {
                const fileName = row.querySelector('.file-name').textContent.toLowerCase();

                row.style.display = fileName.includes(searchValue) ? '' : 'none';
            });
        });

        
        function renameFile(fileId, oldName) {

            const newName = prompt('Enter new file name:', oldName);

            if (newName === null) {
                return;
            }

            if (newName.trim() === '') {
                alert('File name cannot be empty');
                return;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/rename-file/' + encodeURIComponent(fileId);

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'filename';
            input.value = newName.trim();

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

    </script>

</body>
</html>
